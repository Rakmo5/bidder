# ==============================================================================
# AI Bid Scrutiny & Compliance Verification System - Environment Configuration
# ==============================================================================

PROJECT_NAME="MoRTH-Highway-BidCompliance-AI"
API_V1_STR="/api/v1"
ENVIRONMENT="local"
PORT=8000

# ------------------------------------------------------------------------------
# 🔑 LLM API KEYS (Configure at least ONE of these for live AI extraction)
# ------------------------------------------------------------------------------
# 1. Groq API Key (Recommended for ultra-fast Llama-3.3-70b inference)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# 2. Google Gemini API Key (Alternative multimodal LLM provider)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. HuggingFace Token (Optional fallback)
HF_TOKEN=""

# ------------------------------------------------------------------------------
# 🧠 Model Selection
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER="groq"            # Options: "groq" | "gemini"
GROQ_MODEL="llama-3.3-70b-versatile"    # High-accuracy complex reasoning
FAST_GROQ_MODEL="llama-3.1-8b-instant"  # Low-latency fallback
GEMINI_MODEL="gemini-1.5-flash"         # Multimodal document analysis
